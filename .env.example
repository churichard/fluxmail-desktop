# Google OAuth credentials for the installed desktop application.
# Custom credentials request full Gmail access, including permanent deletion.
FLUXMAIL_DESKTOP_GOOGLE_CLIENT_ID=
FLUXMAIL_DESKTOP_GOOGLE_CLIENT_SECRET=

# Release signing and notarization. APPLE_API_KEY is a path to an App Store Connect API key.
APPLE_SIGNING_IDENTITY=
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
